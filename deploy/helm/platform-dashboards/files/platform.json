  {
   "id": 18,
   "type": "timeseries",
   "title": "Gönderim kuyruğu doluluğu",
   "description": "**Ne gösterir:** Consumer'ın hedeflere yazmadan önce beklettiği kuyruğun doluluğu.\n\n**Normalde:** %0'a yakın.\n\n**Kırmızı/turuncuysa:** %80 üstü: hedef yavaş; dolarsa kayıt düşer.",
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (exporter) (otelcol_exporter_queue_size{job=~\".*telemetry-consumer.*\"} / otelcol_exporter_queue_capacity{job=~\".*telemetry-consumer.*\"})",
     "legendFormat": "{{exporter}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
