     },
     "expr": "sum(increase({__name__=~\"otelcol_exporter_send_failed_(metric_points|log_records|spans)\",job=~\".*telemetry-consumer.*\"}[15m])) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
