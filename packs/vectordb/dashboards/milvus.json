     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(kube_pod_status_ready{namespace=\"$tenant\",condition=\"true\",pod=~\".*-milvus-proxy-.*\"})",
     "legendFormat": ""
