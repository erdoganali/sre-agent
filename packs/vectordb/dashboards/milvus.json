{
 "uid": "vectordb-milvus",
 "title": "VectorDB / Milvus",
 "tags": [
  "sre-agent",
  "vectordb",
  "milvus"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "Üretildi: packs/vectordb/dashboards/build.py (make dashboards); elle değiştirme.",
 "templating": {
  "list": [
   {
    "name": "tenant",
    "label": "Tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(milvus_rootcoord_timestamp{job=\"milvus-metrics\"}, k8s_namespace_name)",
     "refId": "tenant"
    },
    "definition": "label_values(milvus_rootcoord_timestamp{job=\"milvus-metrics\"}, k8s_namespace_name)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "SRE raporları",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "red",
    "target": {
     "type": "tags",
     "tags": [
      "sre-agent",
      "namespace=$tenant"
     ],
     "matchAny": false,
     "limit": 200
    }
   },
   {
    "name": "Alarmlar",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "ALERTS{alertstate=\"firing\",team=\"vectordb\",namespace=\"$tenant\"} or ALERTS{alertstate=\"firing\",team=\"vectordb\",k8s_namespace_name=\"$tenant\"}",
    "titleFormat": "{{alertname}}",
    "textFormat": "{{severity}}",
    "step": "60s"
   },
   {
    "name": "Chaos deneyleri",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "purple",
    "expr": "max by (chaosresult_namespace, chaosresult_name, fault_name) (litmuschaos_awaited_experiments) > 0",
    "titleFormat": "Chaos: {{fault_name}}",
    "textFormat": "{{chaosresult_namespace}} / {{chaosresult_name}} (Litmus)",
    "step": "30s"
   }
  ]
 },
 "panels": [
